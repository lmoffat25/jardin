includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # Le plus strict tenable dès le premier commit, et il ne baisse jamais (C8, O18).
    level: max
    paths:
        - app
        - src
        - bootstrap/app.php
        - config
        - database
        - routes
    # JobDeJardin n'a pas encore de job qui l'utilise (D-81) : PHPStan n'analyse
    # pas un trait inutilisé. L'exception devient une erreur (« ignored error
    # pattern was not matched ») dès le premier job réel : la retirer alors.
    ignoreErrors:
        -
            identifier: trait.unused
            path: src/Support/Jardin/JobDeJardin.php
