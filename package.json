{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write resources/js resources/css vite.config.ts eslint.config.js",
        "format:check": "prettier --check resources/js resources/css vite.config.ts eslint.config.js"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@inertiajs/react": "^3.9.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.13.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "laravel-vite-plugin": "^3.2.0",
        "prettier": "^3.9.10",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwindcss": "^4.0.0",
        "typescript": "~7.0.2",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.3.5"
    }
}
